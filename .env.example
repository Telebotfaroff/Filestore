# Telegram bot token from @BotFather
BOT_TOKEN=

# Telegram numeric user ID of the bot owner
OWNER_ID=

# Private Telegram channel ID used to store copied files (bot must be admin)
DB_CHANNEL_ID=

# MongoDB Atlas connection string
MONGODB_URI=
MONGODB_DB_NAME=filestore

# Optional force-subscription channel, e.g. @yourchannel or -1001234567890
FORCE_SUB_CHANNEL=

# Public username of the force-sub channel without @ (used for join button)
FORCE_SUB_URL=

# Optional public support/channel links
UPDATES_URL=
SUPPORT_URL=

# Port for the health endpoint on hosting platforms
PORT=3000

# Optional default auto-delete duration in seconds; 0 disables it
AUTO_DELETE_SECONDS=0

# Set to true to block users from saving files through private chat
PRIVATE_UPLOADS_ENABLED=true

# Optional log level: info | debug
LOG_LEVEL=info
