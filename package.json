{
  "name": "filestore",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram FileStore bot platform",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "build": "npm run check",
    "lint": "npm run check",
    "test": "node --test",
    "check": "find src -name '*.js' -print0 | xargs -0 -n1 node --check",
    "migrate": "node src/database/migrate.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "telegraf": "^4.16.3",
    "zod": "^3.24.2"
  }
}
