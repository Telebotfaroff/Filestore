# App
NODE_ENV=development
LOG_LEVEL=info

# Telegram (Main Bot)
MAIN_BOT_TOKEN=
DELIVERY_BOT_TOKEN= # Optional; enables the administrator-only test Delivery Bot

# Database (Neon PostgreSQL)
DATABASE_URL=

# Token encryption key for dynamic Delivery Bot tokens.
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required only when managing Delivery Bot tokens. Never commit the real key.
TOKEN_ENCRYPTION_KEY=

# Admin Telegram user IDs, comma-separated
ADMIN_IDS=
