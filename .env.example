# Telegram bot token from @BotFather
BOT_TOKEN=

# Telegram numeric user ID of the bot owner
OWNER_ID=

# Private Telegram channel ID used to store copied files (bot must be admin)
DB_CHANNEL_ID=

# MongoDB Atlas connection string
MONGODB_URI=
MONGODB_DB_NAME=filestore

# Optional force-subscription channel, e.g. @yourchannel or -1001234567890
FORCE_SUB_CHANNEL=

# Public username/link for the force-subscription channel
FORCE_SUB_URL=

# Optional public support/channel links
UPDATES_URL=
SUPPORT_URL=

# Port for the health endpoint on hosting platforms
PORT=3000

# Default auto-delete duration for new uploads in seconds; 0 disables it
AUTO_DELETE_SECONDS=0

# Telegram Stars premium plan; 100 Stars for 30 days by default
STARS_PRICE=100
STARS_DAYS=30

# Optional secure shortener integration.
# Must be a provider URL template that substitutes {url} (encoded destination)
# and {click_id} (unique verification session). Provider must send a signed
# server-to-server callback to https://YOUR_HOST/shortener/callback?session=CLICK_ID&signature=HMAC_SHA256.
# Signature = HMAC-SHA256(secret, "<session>:completed"). Never enable a client-only "I completed" button.
SHORTENER_URL_TEMPLATE=
SHORTENER_CALLBACK_SECRET=

# Set to false to block users from saving files through private chat
PRIVATE_UPLOADS_ENABLED=true

# Optional log level: info | debug
LOG_LEVEL=info
